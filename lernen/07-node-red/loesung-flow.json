[
  {
    "id": "lern07_tab",
    "type": "tab",
    "label": "Übung 07",
    "disabled": false,
    "info": "Musterlösung zur Lerneinheit 07: USGS-Feed holen und zusammenfassen."
  },
  {
    "id": "lern07_inject",
    "type": "inject",
    "z": "lern07_tab",
    "name": "Start",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 110,
    "y": 80,
    "wires": [["lern07_http"]]
  },
  {
    "id": "lern07_http",
    "type": "http request",
    "z": "lern07_tab",
    "name": "USGS M4.5+ letzter Tag",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 310,
    "y": 80,
    "wires": [["lern07_fn"]]
  },
  {
    "id": "lern07_fn",
    "type": "function",
    "z": "lern07_tab",
    "name": "Zusammenfassung",
    "func": "const features = msg.payload.features;\nif (!features.length) {\n  msg.payload = 'Keine Beben';\n  return msg;\n}\nconst strongest = features.reduce((best, f) => (f.properties.mag > best.properties.mag ? f : best));\nmsg.payload = `${features.length} Beben, stärkstes: M${strongest.properties.mag} bei ${strongest.properties.place}`;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 80,
    "wires": [["lern07_debug"]]
  },
  {
    "id": "lern07_debug",
    "type": "debug",
    "z": "lern07_tab",
    "name": "Ausgabe",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 720,
    "y": 80,
    "wires": []
  }
]
